# Server-only. Never prefix with VITE_ and never commit a real production value.
# The URL below is the local Docker default from docker-compose.yml.
# Host port 5440 keeps this database off other Postgres instances already using 5432.
DATABASE_URL=postgresql://apothecary:apothecary@localhost:5440/apothecary

# Used only by `npm run db:seed` to create the first admin. Signup cannot create an admin.
# Change this password before sharing the machine.
ADMIN_EMAIL=admin@63rdstreetapothecary.com
ADMIN_PASSWORD=local-admin-change-me

# Reserved for a future payment webhook. The browser cannot mark an order paid.
PAYMENT_WEBHOOK_SECRET=
